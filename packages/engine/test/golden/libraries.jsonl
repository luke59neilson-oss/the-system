{"id":"lb33","type":"library.seeded","timestamp":"2026-10-22T14:00:07.000Z","actor":{"role":"gm"},"sessionId":"s1","schemaVersion":1,"payload":{"skills":[{"id":"lb8","name":"Basic Archery","rarity":"inferior","tags":["Archer"],"description":"Grants a basic understanding of the bow. Slightly improves draw strength, aim and the speed of nocking an arrow.","flavor":"Every hunter starts with a string and a stick.","effects":""},{"id":"lb9","name":"Basic Stealth","rarity":"inferior","tags":["Archer"],"description":"Move with less sound and draw less attention while unseen. Slightly harder to notice while standing still.","flavor":"The prey that never hears you never runs.","effects":""},{"id":"lb10","name":"Archer’s Eye","rarity":"common","tags":["Archer"],"description":"Sharpens sight at range. Distant targets are easier to track, and the path of a shot is easier to judge.","flavor":"See it first. Hit it first.","effects":""},{"id":"lb11","name":"Basic One-Handed Weapons","rarity":"inferior","tags":["Warrior","Melee"],"description":"Grants a basic understanding of swords, axes and maces held in one hand. Slightly improves balance, edge alignment and recovery after a swing.","flavor":"Point the sharp end at the problem.","effects":""},{"id":"lb12","name":"Basic Shield Defense","rarity":"inferior","tags":["Warrior","Defense"],"description":"Read incoming blows and meet them with a shield. Slightly reduces the force that gets through.","flavor":"A wall that walks.","effects":""},{"id":"lb13","name":"Battle Cry","rarity":"common","tags":["Warrior","Stamina"],"description":"Let out a roar that steadies allies who hear it and rattles weaker foes. Costs Stamina.","flavor":"Loud is a tactic.","effects":""},{"id":"lb14","name":"Basic Mana Manipulation","rarity":"inferior","tags":["Mage","Healer","Mana"],"description":"Feel the mana inside you and move it where you want it. The foundation of every spell.","flavor":"First you learn it is there. Then you learn it listens.","effects":""},{"id":"lb15","name":"Mana Bolt","rarity":"common","tags":["Mage","Mana","Ranged"],"description":"Shape mana into a bolt and throw it. Costs Mana; harder hits cost more.","flavor":"Raw, blunt, and very much yours.","effects":""},{"id":"lb16","name":"Basic Meditation","rarity":"inferior","tags":["Mage","Mana"],"description":"Sit still and breathe to recover Mana faster while out of danger.","flavor":"The quiet is a well.","effects":""},{"id":"lb17","name":"Minor Heal","rarity":"common","tags":["Healer","Mana"],"description":"Push mana into a wound to close it. Costs Mana; works best on fresh injuries.","flavor":"Hold still. This will only sting a little.","effects":""},{"id":"lb18","name":"Soothing Presence","rarity":"inferior","tags":["Healer","Support"],"description":"Those near you calm a little faster: panic fades and breathing slows.","flavor":"Somebody has to keep their head.","effects":""},{"id":"lb19","name":"Basic Daggers","rarity":"inferior","tags":["Rogue","Melee"],"description":"Grants a basic understanding of short blades. Slightly improves grip, quick strikes and throws.","flavor":"Small blade, short story.","effects":""},{"id":"lb20","name":"Find Weakness","rarity":"common","tags":["Rogue","Perception"],"description":"Study a target for a moment to spot a gap in its guard or armour.","flavor":"Everything has a soft spot. Everything.","effects":""},{"id":"lb21","name":"Basic Unarmed Combat","rarity":"inferior","tags":["Brawler","Melee"],"description":"Grants a basic understanding of fists, knees and elbows. Slightly improves footwork and how hard a punch lands.","flavor":"Never unarmed.","effects":""},{"id":"lb22","name":"Iron Skin","rarity":"common","tags":["Brawler","Defense","Stamina"],"description":"Tense your body to shrug off a blow. Costs Stamina while held.","flavor":"Bruises are just opinions.","effects":""},{"id":"lb23","name":"Second Wind","rarity":"inferior","tags":["Brawler","Stamina"],"description":"Once a fight, catch your breath and recover some Stamina.","flavor":"Not yet.","effects":""}],"classes":[{"id":"lb24","name":"Archer","description":"Strikes from range; sharp eyes and quick feet.","skills":[{"name":"Basic Archery","rarity":"inferior"},{"name":"Basic Stealth","rarity":"inferior"},{"name":"Archer’s Eye","rarity":"common"}],"weights":{"strength":2,"agility":3,"endurance":1,"vitality":1,"toughness":1,"wisdom":1,"intelligence":1,"perception":3,"willpower":1}},{"id":"lb25","name":"Mage","description":"Shapes raw mana into attacks; fragile but dangerous at range.","skills":[{"name":"Basic Mana Manipulation","rarity":"inferior"},{"name":"Mana Bolt","rarity":"common"},{"name":"Basic Meditation","rarity":"inferior"}],"weights":{"strength":1,"agility":1,"endurance":1,"vitality":1,"toughness":1,"wisdom":3,"intelligence":3,"perception":1,"willpower":2}},{"id":"lb26","name":"Healer","description":"Keeps the party standing; mends wounds and steadies nerves.","skills":[{"name":"Minor Heal","rarity":"common"},{"name":"Basic Mana Manipulation","rarity":"inferior"},{"name":"Soothing Presence","rarity":"inferior"}],"weights":{"strength":1,"agility":1,"endurance":1,"vitality":2,"toughness":1,"wisdom":3,"intelligence":2,"perception":1,"willpower":2}},{"id":"lb27","name":"Rogue","description":"Quick, quiet and precise; strikes where it hurts most.","skills":[{"name":"Basic Daggers","rarity":"inferior"},{"name":"Basic Stealth","rarity":"inferior"},{"name":"Find Weakness","rarity":"common"}],"weights":{"strength":2,"agility":3,"endurance":1,"vitality":1,"toughness":1,"wisdom":1,"intelligence":1,"perception":2,"willpower":1}},{"id":"lb28","name":"Brawler","description":"Fights with fists and grit; tough to put down.","skills":[{"name":"Basic Unarmed Combat","rarity":"inferior"},{"name":"Iron Skin","rarity":"common"},{"name":"Second Wind","rarity":"inferior"}],"weights":{"strength":3,"agility":2,"endurance":2,"vitality":2,"toughness":2,"wisdom":1,"intelligence":1,"perception":1,"willpower":1}}],"races":[],"professions":[{"id":"lb29","name":"Alchemist","description":"Brews potions, poisons and reagents from what the world offers.","skills":[{"name":"Basic Brewing","rarity":"common"},{"name":"Herbalism","rarity":"uncommon"}]},{"id":"lb30","name":"Blacksmith","description":"Forges and repairs weapons and armour.","skills":[{"name":"Basic Smithing","rarity":"common"},{"name":"Appraise Metal","rarity":"uncommon"}]},{"id":"lb31","name":"Tailor","description":"Works hide, cloth and silk into gear and cloaks.","skills":[{"name":"Basic Sewing","rarity":"common"},{"name":"Hide Working","rarity":"uncommon"}]},{"id":"lb32","name":"Scribe","description":"Records knowledge and inscribes runes and scrolls.","skills":[{"name":"Basic Inscription","rarity":"common"},{"name":"Copy Rune","rarity":"uncommon"}]}]}}
